# Copy to .env in repo root or bridge/ — loaded by python-dotenv if present.
# At minimum, set ONE provider key for the LLM you want to use.

# NewAPI / Gemini pool (Hermes new-api at http://127.0.0.1:3100/v1) — shared free keys
# Set keys here for a repo-only install, or use ~/.config/syx-llm-overlord/.env.
# NEWAPI_API_KEY=

# OpenRouter free tier (:free models in dashboard — no local GPU required)
OPENROUTER_API_KEY=

# OpenAI
# OPENAI_API_KEY=

# Anthropic (pip install anthropic)
# ANTHROPIC_API_KEY=

# Optional path overrides (defaults work for a fresh git clone)
# SYX_OVERLORD_ROOT=/path/to/syx-llm-overlord
# SYX_MEMORY_PATH=/path/to/overlord-memory.jsonl
# SYX_WIKI_DIR=/path/to/wiki
# SYX_PLAYBOOK_PATH=/path/to/wiki/rules/playbook.md

# Songs of Syx install (used by install.sh / pom.xml — not read by bridge)
# SONGSOFSYX_JAR=/path/to/SongsOfSyx.jar
