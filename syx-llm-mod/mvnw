#!/bin/bash
# Maven Wrapper bootstrap - downloads Maven 3.9.9 to ~/.m2/wrapper if not present
set -e

MAVEN_VERSION="3.9.9"
WRAPPER_DIR=".mvn/wrapper"
MAVEN_HOME="${HOME}/.m2/wrapper/dists/apache-maven-${MAVEN_VERSION}"

mkdir -p "$WRAPPER_DIR"

if [ ! -d "$MAVEN_HOME" ]; then
    echo "Downloading Maven ${MAVEN_VERSION}..."
    mkdir -p "$MAVEN_HOME"
    curl -sL "https://archive.apache.org/dist/maven/maven-3/${MAVEN_VERSION}/binaries/apache-maven-${MAVEN_VERSION}-bin.tar.gz" | tar xz -C "$MAVEN_HOME" --strip-components=1
    echo "Maven ${MAVEN_VERSION} installed to ${MAVEN_HOME}"
fi

exec "${MAVEN_HOME}/bin/mvn" "$@"
